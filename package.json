{
  "name": "project-management-tool",
  "version": "1.0.0",
  "description": "Scrum-style project management web app with product backlog, sprint board, burndown charts and team administration.",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./public/tailwind-output.css",
    "build:js": "webpack --mode production",
    "watch": "tailwindcss -i ./src/input.css -o ./public/tailwind-output.css --watch"
  },
  "keywords": [
    "project-management",
    "scrum",
    "agile",
    "sprint-board",
    "firebase",
    "tailwindcss",
    "react"
  ],
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-react": "^7.24.7",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.10",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "antd": "^5.20.6",
    "dayjs": "^1.11.13",
    "moment": "^2.30.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
